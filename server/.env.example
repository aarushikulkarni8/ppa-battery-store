# ---------- Core ----------
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ppa?retryWrites=true&w=majority
# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Where the React app runs in development (only needed if you don't use the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173

# ---------- Owner email (Nodemailer + SMTP) ----------
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER
SMTP_FROM=

# ---------- Shop and reminders ----------
# true = show prices and let customers add to cart / order online.
# Leave empty or false = catalogue only: no prices, no cart; customers use "Ask for price".
ONLINE_SHOP=false

# Half-yearly servicing reminder emails (automotive and inverter batteries). On by default; set to off to stop them.
SERVICE_REMINDERS=on
# Optional: lets an outside scheduler (e.g. cron-job.org) trigger reminders at
#   https://your-site/api/cron/service-reminders?key=THIS_VALUE
# useful if your host puts the server to sleep. Leave empty to disable that address.
CRON_SECRET=

# ---------- Images (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- First admin (created by `npm run seed`) ----------
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-now

# Opening stock given to every priced product when seeding (set real stock in /admin)
SEED_DEFAULT_STOCK=10
